            });
            
            document.getElementById('city3Next').onclick = function() {
                goToScreen('screen-codebreak');
            };
        }
        
        // ===== 11: CODE BREAK =====
        function initCodeBreak() {
            var inputs = document.querySelectorAll('#codeInputRow .code-input');
            inputs.forEach(function(inp) {
                inp.value = '';
                inp.classList.remove('correct-char');
                inp.oninput = function(e) { handleCodeInput(e); };
            });
            inputs[0].focus();
            
            document.getElementById('codeCheckBtn').onclick = function() { checkCode(); };
        }
        
        function handleCodeInput(e) {
            var inputs = document.querySelectorAll('#codeInputRow .code-input');
            var idx = parseInt(e.target.getAttribute('data-index'));
            
            if (e.target.value && idx < 4) {
                inputs[idx + 1].focus();
            }
        }
        
        function checkCode() {
            var inputs = document.querySelectorAll('#codeInputRow .code-input');
            var code = '';
            inputs.forEach(function(inp) { code += inp.value.toUpperCase(); });
            
            var valid = false;
            if (code.length === 3 && code === 'SUP') valid = true;
            if (code.indexOf('SUP') !== -1 || code.indexOf('САП') !== -1) valid = true;
            
            if (valid) {
                inputs.forEach(function(inp) { inp.classList.add('correct-char'); });
                showNotification('ШИФР ВЗЛОМАН!', 'Тихонов: "Это SUP! Сапы! Он планирует SUP-сплав!"');
                document.getElementById('codeHint2').textContent = '✓ Код разгадан: SUP! Переход к финалу...';
                document.getElementById('codeHint2').style.color = '#27ae60';
                setTimeout(function() { goToScreen('screen-timeline'); }, 2500);
            } else if (code.length >= 3) {
                showNotification('НЕВЕРНО', 'Попробуйте ещё. Подсказка: 3 буквы на английском. S-U-...');
                inputs.forEach(function(inp) {
                    inp.style.borderColor = '#e74c3c';
                    setTimeout(function() { inp.style.borderColor = '#444'; }, 500);
                });
            }
        }
        
        // ===== 12: TIMELINE =====
        var timelineItems = [
            { time: 'Этап 1', text: 'Тихонов нашёл поисковые запросы про SUP-доски и сплав' },
            { time: 'Этап 2', text: 'Обнаружены улики: жилет, крем от загара, сандали' },
            { time: 'Этап 3', text: 'Города не подходят — Коломна, Серпухов, Дмитров — всё мимо' },
            { time: 'Этап 4', text: 'Майский нашёл точки у воды — база, лагерь, парковка' },
            { time: 'Этап 5', text: 'Антонова разобрала рюкзак: всё для водного отдыха' },
            { time: 'Этап 6', text: 'Гордеева перехватила: "надувные доски", "вёсла", "закат с воды"' },
            { time: 'Этап 7', text: 'Белая раскрыла пары: всё связано с SUP' },
            { time: 'Этап 8', text: 'Тихонов взломал шифр: SUP!' },
        ];
        
        function initTimeline() {
            var container = document.getElementById('timeline');
            container.innerHTML = '';
            timelineResolved = 0;
            document.getElementById('timelineNext').style.display = 'none';
            
            timelineItems.forEach(function(item, idx) {
                var div = document.createElement('div');
                div.className = 'timeline-item';
                div.innerHTML = '<div class="tl-time mono">' + item.time + '</div><div class="tl-text">' + item.text + '</div>';
                div.onclick = function() {
                    if (div.classList.contains('resolved')) return;
                    div.classList.add('resolved');
                    timelineResolved++;
                    
                    if (timelineResolved >= timelineItems.length) {
                        setTimeout(function() {
                            document.getElementById('timelineNext').style.display = 'inline-block';
                            showNotification('ВСЕ ЭТАПЫ ПРОЙДЕНЫ', 'Рогозина: "Дело готово к раскрытию. Приступайте!"');
                        }, 500);
                    }
                };
                container.appendChild(div);
            });
            
            document.getElementById('timelineNext').onclick = function() {
                goToScreen('screen-final');
            };
        }
        
        // ===== 13: FINAL =====
        function initFinal() {
            document.getElementById('finalTitle').textContent = 'Подождите...';
            document.getElementById('finalLetter').style.display = 'none';
            document.getElementById('finalInvitation').style.display = 'none';
            noClickCount = 0;
            
            setTimeout(function() {
                document.getElementById('finalTitle').textContent = 'Что?!';
            }, 1500);
            
            setTimeout(function() {
                document.getElementById('finalTitle').textContent = 'Это НЕ поездка в город?!';
            }, 3000);
            
            setTimeout(function() {
                document.getElementById('finalTitle').innerHTML = '🏄‍♀️ ЭТО SUP-СПЛАВ! 🏄‍♂️';
                document.getElementById('finalTitle').style.animation = 'pulse 1s infinite';
            }, 4500);
            
            setTimeout(function() {
                document.getElementById('finalLetter').style.display = 'block';
            }, 5500);
            
            setTimeout(function() {
                document.getElementById('finalInvitation').style.display = 'block';
                
                document.getElementById('btnYes').onclick = function() { sayYes(); };
                document.getElementById('btnNo').onclick = function() { sayNo(); };
            }, 6500);
        }
        
        function sayYes() {
            goToScreen('screen-celebration');
            setTimeout(launchConfetti, 500);
        }
        
        function sayNo() {
            noClickCount++;
            var btn = document.getElementById('btnNo');
            
            var messages = [
                'Ты уверена? Подумай ещё раз! 🥺',
                'Серьёзно? Там будет так круто!',
                'Ладно... но я не сдаюсь! 😄',
                'Ну пожааалуйста! 🙏',
                'Я буду рядом и помогу тебе держаться! 🤝',
                'Это будет лучший выходной!',
                'Окей, последний аргумент: ЗАКАТ НА РЕКЕ 🌅',
            ];
            
            if (noClickCount <= messages.length) {
                btn.textContent = messages[noClickCount - 1];
                btn.style.animation = 'shake 0.5s';
                setTimeout(function() { btn.style.animation = ''; }, 500);
                
                if (noClickCount >= messages.length) {
                    btn.textContent = 'Ну ладно... ДА! 😄';
                    btn.onclick = function() { sayYes(); };
                    btn.style.borderColor = '#27ae60';
                    btn.style.color = '#27ae60';
                }
            }
        }
        
        // ===== CELEBRATION =====
        function launchConfetti() {
            var colors = ['#e74c3c','#f39c12','#27ae60','#3498db','#9b59b6','#1abc9c','#e91e63'];
            
            for (var i = 0; i < 80; i++) {
                setTimeout(function(i) {
                    return function() {
                        var confetti = document.createElement('div');
                        confetti.className = 'confetti';
                        confetti.style.left = Math.random() * 100 + 'vw';
                        confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
                        confetti.style.width = (Math.random() * 10 + 5) + 'px';
                        confetti.style.height = (Math.random() * 10 + 5) + 'px';
                        confetti.style.animationDuration = (Math.random() * 3 + 2) + 's';
                        document.body.appendChild(confetti);
                        
                        setTimeout(function() { confetti.remove(); }, 5000);
                    };
                }(i), i * 50);
            }
        }
        
        // ===== KEYBOARD =====
        document.addEventListener('keydown', function(e) {
            if (currentScreen === 'screen-codebreak' && e.key === 'Enter') {
                checkCode();
            }
        });
        
        // ===== INIT =====
        window.addEventListener('load', function() {
            startLoading();
        });
    </script>
</body>
</html>
